{
  "name": "echoframe-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "engines": {"node": ">=24.0.0 <27"},
  "scripts": {
    "dev": "node scripts/build.mjs && corepack pnpm --filter @echoframe/web dev",
    "build:packages": "node scripts/build.mjs",
    "build": "node scripts/build.mjs && corepack pnpm --filter @echoframe/web build && node scripts/budget.mjs",
    "typecheck": "node scripts/build.mjs && tsc -p apps/web/tsconfig.json && tsc -p test/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:consumer": "node scripts/consumer.mjs",
    "test:performance": "node scripts/performance.mjs",
    "audit:licenses": "node scripts/licenses.mjs",
    "cli": "node packages/cli/dist/index.js",
    "fixtures": "tsx scripts/fixtures.ts",
    "release:check": "node scripts/release-check.mjs",
    "quality": "corepack pnpm typecheck && corepack pnpm lint && corepack pnpm test && corepack pnpm build && corepack pnpm test:consumer && corepack pnpm test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@x402/core": "2.31.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "mppx": "0.21.0",
    "viem": "2.58.1",
    "zod": "4.6.7",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "fast-check": "4.10.3",
    "lighthouse": "13.6.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
